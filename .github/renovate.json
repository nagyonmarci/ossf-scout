{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "configMigration": true,
  "schedule": ["every weekend"],
  "pinDigests": true,

  "packageRules": [
    {
      "description": "Auto-merge patch updates after a 7-day cooldown (matchConfidence needs Mend credentials and paused Renovate, see #59)",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Group docker/* GitHub Actions into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "docker GitHub Actions",
      "matchPackageNames": [
        "/^docker//"
      ]
    },
    {
      "description": "Group actions/* GitHub Actions into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub official actions",
      "matchPackageNames": [
        "/^actions//"
      ]
    },
    {
      "description": "Group Dockerfile security tool versions (trivy, helm, zizmor, kube-linter, trufflehog, go install tools) into a single PR. No automerge: SHA256 pins need a manual update and CI does not build the image",
      "matchManagers": ["custom.regex"],
      "groupName": "Dockerfile security tool versions",
      "automerge": false
    },
    {
      "description": "Group Docker base image digest updates into a single PR, require manual review",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"],
      "groupName": "Docker base image digests",
      "automerge": false
    }
  ],

  "customManagers": [
    {
      "customType": "regex",
      "description": "go install github.com/<owner>/<repo>[/...]@vX.Y.Z lines in the Dockerfile",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["go install github\\.com/(?<depName>[^/\\s]+/[^/@\\s]+)[^@\\s]*@(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG TRIVY_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG HELM_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG ZIZMOR_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG KUBELINTER_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "stackrox/kube-linter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG TRUFFLEHOG_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "trufflesecurity/trufflehog",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
